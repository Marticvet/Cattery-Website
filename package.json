{
  "name": "maison-aurelia-cattery",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:demo": "CONTENT_MODE=demo next dev",
    "build": "next build",
    "build:demo": "CONTENT_MODE=demo next build",
    "start": "next start",
    "start:demo": "CONTENT_MODE=demo next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "sanity:extract": "sanity schema extract --enforce-required-fields",
    "sanity:validate": "node --import tsx scripts/validate-schema.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@portabletext/react": "8.0.1",
    "@sanity/client": "8.9.0",
    "@sanity/image-url": "2.1.1",
    "next": "16.3.7",
    "next-sanity": "13.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "6.17.0",
    "server-only": "0.0.1",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "groq-js": "2.0.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@module-federation/dts-plugin": {
      "adm-zip": "^0.6.1",
      "undici": "^7.30.0"
    },
    "@vercel/frameworks": {
      "js-yaml": "^3.15.2",
      "smol-toml": "^1.9.0"
    },
    "typeid-js": {
      "uuid": "^11.1.1"
    }
  }
}
