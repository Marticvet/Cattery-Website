# Create a project at https://www.sanity.io/manage. Use a public dataset for public content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: a viewer token for a private dataset. Server-only; never use NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
# Optional: match the secret on your Sanity document webhook.
SANITY_REVALIDATE_SECRET=

# sanity (default) or demo. Demo is fictional, isolated, and always noindex.
# You can instead use npm run dev:demo without changing this value.
CONTENT_MODE=sanity
